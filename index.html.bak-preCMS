<!DOCTYPE html>
<html lang="pl">
<head>
<meta charset="UTF-8">
<meta name="vewport" content="width=device-width, initial-scale=1.0">
<title>Gabinet Masażu Tina — Niepołomice</title>
<meta name="description" content="Gabinet Masażu Tina w Niepołomicach — masaż relaksacyjny, klasyczny, Kobido i pielęgnacja twarzy. Rezerwacja online przez Booksy.">
<link rel="icon" href="data:,">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --cream:#f7f3ec;
    --cream-2:#efe8db;
    --sage:#8a9a7e;
    --sage-dark:#5f7157;
    --ink:#3a352e;
    --ink-soft:#6b6459;
    --terracotta:#c18b6a;
    --white:#ffffff;
    --radius:18px;
    --shadow: 0 10px 30px rgba(58,53,46,0.08);
  }
  *{box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{
    margin:0;
    font-family:'Inter', sans-serif;
    color:var(--ink);
    background:var(--cream);
    line-height:1.6;
  }
  h1,h2,h3{
    font-family:'Cormorant Garamond', serif;
    font-weight:600;
    letter-spacing:0.01em;
    margin:0 0 0.4em;
  }
  a{color:inherit;}
  .container{
    max-width:1080px;
    margin:0 auto;
    padding:0 24px;
  }
  /* Nav */
  header{
    position:sticky; top:0; z-index:50;
    background:rgba(247,243,236,0.9);
    backdrop-filter:blur(6px);
    border-bottom:1px solid rgba(58,53,46,0.08);
  }
  nav{
    display:flex; align-items:center; justify-content:space-between;
    padding:16px 24px;
    max-width:1080px; margin:0 auto;
  }
  .logo{
    font-family:'Cormorant Garamond', serif;
    font-size:1.5rem; font-weight:700; color:var(--sage-dark);
  }
  .lang-toggle{
    display:flex; gap:6px; background:var(--cream-2); border-radius:999px; padding:4px;
  }
  .lang-toggle button{
    border:none; background:transparent; padding:6px 14px; border-radius:999px;
    font-family:'Inter'; font-size:0.85rem; cursor:pointer; color:var(--ink-soft);
  }
  .lang-toggle button.active{background:var(--sage-dark); color:var(--white);}
  /* Hero */
  .hero{
    display:grid; grid-template-columns:1.1fr 1fr; gap:40px; align-items:center;
    padding:64px 24px 48px; max-width:1080px; margin:0 auto;
  }
  .hero .eyebrow{
    text-transform:uppercase; letter-spacing:0.14em; font-size:0.78rem;
    color:var(--terracotta); font-weight:600; margin-bottom:14px;
  }
  .hero h1{font-size:clamp(2.2rem,4vw,3.2rem); color:var(--ink);}
  .hero p.lead{color:var(--ink-soft); font-size:1.05rem; max-width:46ch; margin:14px 0 28px;}
  .rating{display:flex; align-items:center; gap:8px; margin-bottom:24px; font-size:0.95rem; color:var(--ink-soft);}
  .stars{color:#d9a441; letter-spacing:2px;}
  .cta-row{display:flex; gap:14px; flex-wrap:wrap;}
  .btn{
    display:inline-flex; align-items:center; gap:8px;
    padding:14px 26px; border-radius:999px; text-decoration:none;
    font-weight:600; font-size:0.95rem; transition:transform .15s ease, box-shadow .15s ease;
  }
  .btn-primary{background:var(--sage-dark); color:var(--white); box-shadow:var(--shadow);}
  .btn-primary:hover{transform:translateY(-2px);}
  .btn-outline{border:1.5px solid var(--sage-dark); color:var(--sage-dark);}
  .btn-outline:hover{background:var(--sage-dark); color:var(--white);}
  .hero-photo{
    border-radius:var(--radius); overflow:hidden; box-shadow:var(--shadow);
    aspect-ratio:4/5;
  }
  .hero-photo img{width:100%; height:100%; object-fit:cover; display:block;}
  /* Section generic */
  section{padding:56px 0;}
  .section-title{text-align:center; max-width:640px; margin:0 auto 40px;}
  .section-title .eyebrow{
    text-transform:uppercase; letter-spacing:0.14em; font-size:0.78rem;
    color:var(--terracotta); font-weight:600; display:block; margin-bottom:10px;
  }
  .section-title h2{font-size:clamp(1.7rem,3vw,2.3rem);}
  .section-title p{color:var(--ink-soft); margin-top:10px;}
  /* About */
  .about{
    display:grid; grid-template-columns:0.9fr 1.1fr; gap:48px; align-items:center;
  }
  .about-photo{border-radius:var(--radius); overflow:hidden; box-shadow:var(--shadow);}
  .about-photo img{width:100%; display:block;}
  .about-text h2{font-size:clamp(1.6rem,3vw,2.1rem);}
  .about-text p{color:var(--ink-soft);}
  .badge-row{display:flex; gap:12px; margin-top:22px; flex-wrap:wrap;}
  .badge{
    background:var(--white); border-radius:12px; padding:12px 16px; box-shadow:var(--shadow);
    font-size:0.85rem; color:var(--ink-soft); display:flex; align-items:center; gap:8px;
  }
  /* Services */
  .services{background:var(--cream-2);}
  .service-grid{
    display:grid; grid-template-columns:repeat(auto-fit,minmax(260px,1fr)); gap:20px;
  }
  .service-card{
    background:var(--white); border-radius:var(--radius); padding:24px; box-shadow:var(--shadow);
    display:flex; flex-direction:column; gap:10px;
  }
  .service-card h3{font-size:1.25rem; color:var(--ink);}
  .service-meta{display:flex; justify-content:space-between; align-items:baseline; margin-top:auto;}
  .service-price{font-family:'Cormorant Garamond', serif; font-size:1.4rem; font-weight:700; color:var(--sage-dark);}
  .service-duration{font-size:0.85rem; color:var(--ink-soft);}
  .service-card p{color:var(--ink-soft); font-size:0.92rem; margin:0;}
  /* Gallery */
  .gallery-grid{
    display:grid; grid-template-columns:repeat(3,1fr); gap:14px;
  }
  .gallery-grid img{
    width:100%; height:220px; object-fit:cover; border-radius:14px; box-shadow:var(--shadow);
    display:block;
  }
  /* Contact */
  .contact{
    background:var(--sage-dark); color:var(--cream); border-radius:24px;
    padding:56px 40px; text-align:center; margin:0 24px;
  }
  .contact h2{color:var(--white);}
  .contact p{color:rgba(247,243,236,0.85);}
  .contact .cta-row{justify-content:center; margin-top:24px;}
  .contact .btn-primary{background:var(--white); color:var(--sage-dark);}
  .contact .btn-outline{border-color:var(--cream); color:var(--cream);}
  .contact .btn-outline:hover{background:var(--cream); color:var(--sage-dark);}
  .info-line{margin-top:28px; font-size:0.95rem; color:rgba(247,243,236,0.85);}
  footer{
    text-align:center; padding:28px 24px; color:var(--ink-soft); font-size:0.85rem;
  }
  footer a{color:var(--sage-dark); text-decoration:none; font-weight:600;}
  [data-i18n]{}
  @media (max-width:820px){
    .hero{grid-template-columns:1fr; padding-top:36px;}
    .hero-photo{order:-1; max-width:360px; margin:0 auto;}
    .about{grid-template-columns:1fr;}
    .gallery-grid{grid-template-columns:repeat(2,1fr);}
    nav{padding:14px 16px;}
  }
  @media (max-width:480px){
    .gallery-grid{grid-template-columns:1fr 1fr;}
    .gallery-grid img{height:150px;}
    .contact{padding:40px 22px;}
  }
</style>
</head>
<body>

<header>
  <nav>
    <div class="logo">Tina · Gabinet Masażu</div>
    <div class="lang-toggle" role="group" aria-label="Language">
      <button type="button" data-lang="pl" class="active">PL</button>
      <button type="button" data-lang="ua">UA</button>
    </div>
  </nav>
</header>

<section class="hero">
  <div>
    <span class="eyebrow" data-i18n="hero_eyebrow">Niepołomice · Młyńska 3a</span>
    <h1 data-i18n="hero_title">Chwila spokoju dla Twojego ciała i umysłu</h1>
    <p class="lead" data-i18n="hero_lead">Gabinet Masażu Tina — masaż relaksacyjny, klasyczny, japoński Kobido i pielęgnacja twarzy w kameralnej atmosferze, tylko na umówione wizyty.</p>
    <div class="rating">
      <span class="stars">★★★★★</span>
      <span data-i18n="hero_rating">5.0 na podstawie 11 opinii (Booksy)</span>
    </div>
    <div class="cta-row">
      <a class="btn btn-primary" href="https://booksy.com/pl-pl/265397_gabinet-masazu-tina_masaz_9954_niepolomice" target="_blank" rel="noopener" data-i18n="btn_book">Zarezerwuj wizytę</a>
      <a class="btn btn-outline" href="https://www.instagram.com/tina_gabinet_masazu/" target="_blank" rel="noopener" data-i18n="btn_ig">Instagram @tina_gabinet_masazu</a>
    </div>
  </div>
  <div class="hero-photo">
    <img src="images/picture.jpeg" alt="Gabinet Masażu Tina" loading="lazy">
  </div>
</section>

<section class="about">
  <div class="container about" style="padding:0;">
    <div class="about-photo">
      <img src="images/left-shoulder.jpeg" alt="Wnętrze gabinetu" loading="lazy">
    </div>
    <div class="about-text">
      <span class="eyebrow" data-i18n="about_eyebrow">O gabinecie</span>
      <h2 data-i18n="about_title">Prowadzi Alona Artemenko</h2>
      <p data-i18n="about_text">Kameralny gabinet masażu w centrum Niepołomic. Każda wizyta to indywidualnie dobrany zabieg — od klasycznego masażu relaksacyjnego, przez japoński rytuał Kobido, po pielęgnację i modelowanie twarzy. Wizyty wyłącznie po wcześniejszym umówieniu.</p>
      <div class="badge-row">
        <span class="badge" data-i18n="badge_hours">🕘 Pon–Sob 09:00–19:00 (na umówioną wizytę)</span>
        <span class="badge" data-i18n="badge_address">📍 ul. Młyńska 3a, 32-005 Niepołomice</span>
      </div>
    </div>
  </div>
</section>

<section class="services">
  <div class="container">
    <div class="section-title">
      <span class="eyebrow" data-i18n="services_eyebrow">Cennik</span>
      <h2 data-i18n="services_title">Usługi</h2>
      <p data-i18n="services_lead">Ceny orientacyjne — dokładny zakres i cenę potwierdzisz przy rezerwacji w Booksy.</p>
    </div>
    <div class="service-grid" id="service-grid"></div>
  </div>
</section>

<section class="gallery">
  <div class="container">
    <div class="section-title">
      <span class="eyebrow" data-i18n="gallery_eyebrow">Atmosfera</span>
      <h2 data-i18n="gallery_title">Galeria</h2>
    </div>
    <div class="gallery-grid">
      <img src="images/right-shoulder.jpeg" alt="Zdjęcie z gabinetu" loading="lazy">
      <img src="images/neck-light.jpeg" alt="Zdjęcie z gabinetu" loading="lazy">
      <img src="images/work-place.jpeg" alt="Zdjęcie z gabinetu" loading="lazy">
      <img src="images/neck-from-top.jpeg" alt="Zdjęcie z gabinetu" loading="lazy">
      <img src="images/left-shoulder.jpeg" alt="Zdjęcie z gabinetu" loading="lazy">
      <img src="images/picture.jpeg" alt="Gabinet Masażu Tina" loading="lazy">
    </div>
  </div>
</section>

<section>
  <div class="container">
    <div class="contact">
      <h2 data-i18n="contact_title">Umów się na chwilę dla siebie</h2>
      <p data-i18n="contact_lead">Rezerwacja online 24/7 przez Booksy — wybierz usługę, dogodny termin i gotowe.</p>
      <div class="cta-row">
        <a class="btn btn-primary" href="https://booksy.com/pl-pl/265397_gabinet-masazu-tina_masaz_9954_niepolomice" target="_blank" rel="noopener" data-i18n="btn_book">Zarezerwuj wizytę</a>
        <a class="btn btn-outline" href="https://www.instagram.com/tina_gabinet_masazu/" target="_blank" rel="noopener" data-i18n="btn_ig">Instagram @tina_gabinet_masazu</a>
      </div>
      <p class="info-line" data-i18n="contact_info">📍 ul. Młyńska 3a, 32-005 Niepołomice &nbsp;·&nbsp; 🕘 Pon–Sob 09:00–19:00, tylko na umówioną wizytę</p>
    </div>
  </div>
</section>

<footer>
  <span data-i18n="footer_text">Gabinet Masażu Tina · Niepołomice · Rezerwacja przez</span>
  <a href="https://booksy.com/pl-pl/265397_gabinet-masazu-tina_masaz_9954_niepolomice" target="_blank" rel="noopener">Booksy</a>
</footer>

<script>
const services = [
  { pl:"Masaż relaksacyjny", ua:"Розслаблюючий масаж", duration:"60 хв / min", price:"153 zł", descPl:"Delikatny masaż całego ciała redukujący napięcie i stres.", descUa:"Ніжний масаж усього тіла для зняття напруги та стресу." },
  { pl:"Masaż klasyczny", ua:"Класичний масаж", duration:"60 хв / min", price:"153 zł", descPl:"Klasyczna technika poprawiająca krążenie i elastyczność mięśni.", descUa:"Класична техніка для покращення кровообігу та еластичності м’язів." },
  { pl:"Masaż personalny", ua:"Персональний масаж", duration:"90 хв / min", price:"204 zł", descPl:"Wydłużona, indywidualnie dobrana sesja dla głębokiego relaksu.", descUa:"Подовжена індивідуально підібрана сесія для глибокого розслаблення." },
  { pl:"Japoński masaż twarzy Kobido", ua:"Японський масаж обличчя Kobido", duration:"60 хв / min", price:"153 zł", descPl:"Rytuał ujędrniający i odmładzający skórę twarzy.", descUa:"Ритуал для зміцнення та омолодження шкіри обличчя." },
  { pl:"Masaż tajski stóp", ua:"Тайський масаж стоп", duration:"60 хв / min", price:"127,50 zł", descPl:"Relaksujący masaż stóp i łydek techniką tajską.", descUa:"Розслаблюючий масаж стоп і литок за тайською технікою." },
  { pl:"Masaż transbukalny", ua:"Трансбукальний масаж", duration:"40 хв / min", price:"127,50 zł", descPl:"Masaż wewnątrzustny modelujący owal twarzy.", descUa:"Масаж зсередини ротової порожнини для моделювання овалу обличчя." },
  { pl:"Masaż ujędrniający twarzy", ua:"Масаж, що зміцнює обличчя", duration:"60 хв / min", price:"od 153 zł", descPl:"Zabieg liftingujący i napinający skórę twarzy.", descUa:"Ліфтинг-процедура для підтягнення шкіри обличчя." },
];

const i18n = {
  pl:{
    hero_eyebrow:"Niepołomice · Młyńska 3a",
    hero_title:"Chwila spokoju dla Twojego ciała i umysłu",
    hero_lead:"Gabinet Masażu Tina — masaż relaksacyjny, klasyczny, japoński Kobido i pielęgnacja twarzy w kameralnej atmosferze, tylko na umówione wizyty.",
    hero_rating:"5.0 na podstawie 11 opinii (Booksy)",
    btn_book:"Zarezerwuj wizytę",
    btn_ig:"Instagram @tina_gabinet_masazu",
    about_eyebrow:"O gabinecie",
    about_title:"Prowadzi Alona Artemenko",
    about_text:"Kameralny gabinet masażu w centrum Niepołomic. Każda wizyta to indywidualnie dobrany zabieg — od klasycznego masażu relaksacyjnego, przez japoński rytuał Kobido, po pielęgnację i modelowanie twarzy. Wizyty wyłącznie po wcześniejszym umówieniu.",
    badge_hours:"🕘 Pon–Sob 09:00–19:00 (na umówioną wizytę)",
    badge_address:"📍 ul. Młyńska 3a, 32-005 Niepołomice",
    services_eyebrow:"Cennik",
    services_title:"Usługi",
    services_lead:"Ceny orientacyjne — dokładny zakres i cenę potwierdzisz przy rezerwacji w Booksy.",
    gallery_eyebrow:"Atmosfera",
    gallery_title:"Galeria",
    contact_title:"Umów się na chwilę dla siebie",
    contact_lead:"Rezerwacja online 24/7 przez Booksy — wybierz usługę, dogodny termin i gotowe.",
    contact_info:"📍 ul. Młyńska 3a, 32-005 Niepołomice &nbsp;·&nbsp; 🕘 Pon–Sob 09:00–19:00, tylko na umówioną wizytę",
    footer_text:"Gabinet Masażu Tina · Niepołomice · Rezerwacja przez",
  },
  ua:{
    hero_eyebrow:"Нєполоміце · вул. Млинська 3a",
    hero_title:"Хвилина спокою для тіла та розуму",
    hero_lead:"Кабінет масажу Tina — розслаблюючий, класичний масаж, японський Kobido та догляд за обличчям у камерній атмосфері, лише за попереднім записом.",
    hero_rating:"5.0 на основі 11 відгуків (Booksy)",
    btn_book:"Записатися на візит",
    btn_ig:"Instagram @tina_gabinet_masazu",
    about_eyebrow:"Про кабінет",
    about_title:"Веде Альона Артеменко",
    about_text:"Камерний кабінет масажу в центрі Нєполоміце. Кожен візит — індивідуально підібрана процедура: від класичного розслаблюючого масажу, через японський ритуал Kobido, до догляду та моделювання обличчя. Візити лише за попереднім записом.",
    badge_hours:"🕘 Пн–Сб 09:00–19:00 (за попереднім записом)",
    badge_address:"📍 вул. Млинська 3a, 32-005 Нєполоміце",
    services_eyebrow:"Прайс",
    services_title:"Послуги",
    services_lead:"Ціни орієнтовні — точний обсяг та вартість підтвердите під час запису в Booksy.",
    gallery_eyebrow:"Атмосфера",
    gallery_title:"Галерея",
    contact_title:"Запишіться на хвилину для себе",
    contact_lead:"Онлайн-запис 24/7 через Booksy — оберіть послугу, зручний час і готово.",
    contact_info:"📍 вул. Млинська 3a, 32-005 Нєполоміце &nbsp;·&nbsp; 🕘 Пн–Сб 09:00–19:00, лише за попереднім записом",
    footer_text:"Кабінет масажу Tina · Нєполоміце · Запис через",
  }
};

function renderServices(lang){
  const grid = document.getElementById('service-grid');
  grid.innerHTML = services.map(s => `
    <div class="service-card">
      <h3>${lang === 'ua' ? s.ua : s.pl}</h3>
      <p>${lang === 'ua' ? s.descUa : s.descPl}</p>
      <div class="service-meta">
        <span class="service-duration">${s.duration}</span>
        <span class="service-price">${s.price}</span>
      </div>
    </div>
  `).join('');
}

function setLang(lang){
  document.documentElement.lang = lang === 'ua' ? 'uk' : 'pl';
  document.querySelectorAll('[data-i18n]').forEach(el => {
    const key = el.getAttribute('data-i18n');
    if (i18n[lang][key]) el.innerHTML = i18n[lang][key];
  });
  document.querySelectorAll('.lang-toggle button').forEach(btn => {
    btn.classList.toggle('active', btn.dataset.lang === lang);
  });
  renderServices(lang);
}

document.querySelectorAll('.lang-toggle button').forEach(btn => {
  btn.addEventListener('click', () => setLang(btn.dataset.lang));
});

setLang('pl');
</script>

</body>
</html>
